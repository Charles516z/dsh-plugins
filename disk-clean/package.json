{
  "name": "@local/disk-clean",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Scan C: for junk and delete only cache/temp files, with a settings page, an agent tool and scheduled auto-clean.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "bin/clean-now.mjs",
    "lib/targets.js",
    "lib/util.js",
    "lib/disk.js",
    "lib/walk.js",
    "lib/scan.js",
    "lib/clean.js",
    "lib/state.js",
    "lib/schedule.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
